\begin{tikzpicture}[scale=6.0]
    \draw[pared,line width=1.2pt] (0,0) circle (0.51);
    \fill[obstaculo] (-0.0175,0) circle (0.0175);
    \fill[obstaculo] ( 0.0175,0) circle (0.0175);
    \foreach \x/\y/\a in {-0.30/0.22/20, 0.18/0.34/250, 0.33/-0.19/120,
                          -0.22/-0.31/70, 0.05/-0.40/160, -0.40/-0.05/300,
                          0.40/0.12/200, -0.10/0.42/330}{
        \fill[fresca] (\x,\y) circle (0.0175);
        \draw[fresca,-{Stealth[length=1.6mm]},semithick] (\x,\y) -- ++({0.055*cos(\a)},{0.055*sin(\a)});}
    \foreach \x/\y/\a in {0.12/0.08/40, -0.16/0.05/210, 0.26/-0.33/100}{
        \fill[usada] (\x,\y) circle (0.0175);
        \draw[usada,-{Stealth[length=1.6mm]},semithick] (\x,\y) -- ++({0.055*cos(\a)},{0.055*sin(\a)});}
    \draw[azul,-{Latex[length=3pt]}] (0,0) -- (35:0.51)
        node[midway,above,sloped,font=\scriptsize,text=azul] {$R$};
    \draw[acento,{Latex[length=3pt]}-{Latex[length=3pt]}] (0,-0.075) -- (0.0175,-0.075)
        node[below,font=\scriptsize,text=acento,xshift=4pt] {$x_o$};
\end{tikzpicture}%
